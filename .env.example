POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=investinsight_db

# Optional: logo.dev token used by the middleware container for instrument logos.
LOGO_DEV_API_KEY=

# Encrypts Trading 212 API keys stored in the database. Generate once with:
#   openssl rand -base64 32
# Keep it safe: if it is lost or changed, stored keys must be re-entered.
CREDENTIALS_ENCRYPTION_KEY=
